{
  "extends": ["config:js-lib", "github>christophehurpeau/renovate-presets"],
  "packageRules": [
    {
      "description": "keep peer ranges as wide as possible: only widen on new majors",
      "matchManagers": ["npm"],
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen"
    }
  ]
}
